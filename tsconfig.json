{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@screens/*": ["./src/screens/*"],
      "@screens": ["./src/screens"],
      "@components/*": ["./src/components/*"],
      "@components": ["./src/components"],
      "@hooks/*": ["./src/hooks/*"],
      "@hooks": ["./src/hooks"],
      "@db/*": ["./src/db/*"],
      "@db": ["./src/db"],
      "@ar/*": ["./src/ar/*"],
      "@ar": ["./src/ar"],
      "@assets/*": ["./src/assets/*"],
      "@assets": ["./src/assets"],
      "@store/*": ["./src/store/*"],
      "@store": ["./src/store"],
      "@theme/*": ["./src/theme/*"],
      "@theme": ["./src/theme"],
      "@utils/*": ["./src/utils/*"],
      "@utils": ["./src/utils"],
      "@navigation/*": ["./src/navigation/*"],
      "@navigation": ["./src/navigation"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
